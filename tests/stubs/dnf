#!/bin/sh
# Test stub for the Fedora/RHEL package listing command.
#
# The suite runs with this directory ahead of the real one on PATH, because the
# phases that merely need *a* package list would otherwise pay for a real
# `dnf repoquery` every time a backup exports one. The one phase that exists to
# validate the real command's output format (Phase 5) drops the stub from PATH
# and calls the genuine tool.
#
# Emits exactly what the real command's contract promises: one bare package
# name per line, no whitespace, no blank lines.
i=1
while [ "$i" -le 50 ]; do
    printf 'migr-stub-pkg-%02d\n' "$i"
    i=$((i + 1))
done
