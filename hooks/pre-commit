#!/usr/bin/env bash
# migr pre-commit hook

# Halt immediately on any error, including those hidden within pipelines
set -eo pipefail

# Does anything staged affect the build or the suite? If not, skip both to save
# time. tests/stubs/* is matched by path rather than extension on purpose: those
# files shadow real command names on PATH, so they cannot carry one.
if ! git diff --cached --name-only | grep -qE '\.(c|h|sh)$|(^|/)Makefile$|^tests/stubs/'; then
    echo "→ Nothing staged that the build or tests depend on, skipping both."
    exit 0
fi

echo "▶ Running pre-commit checks..."

if ! make > /tmp/migr-build.log 2>&1; then
    echo "× Build failed. See /tmp/migr-build.log for details."
    exit 1
fi

if ! make test > /tmp/migr-test.log 2>&1; then
    echo "× Tests failed. See /tmp/migr-test.log for details."
    exit 1
fi

echo "✓ All checks passed!"
exit 0