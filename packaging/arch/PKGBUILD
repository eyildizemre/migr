# Maintainer: Emre Yıldız <eyildizemre@proton.me>
pkgname=migr
pkgver=0.1.0
pkgrel=1
pkgdesc='Move your home, packages, and settings to a new Linux install'
arch=('x86_64')
url='https://github.com/eyildizemre/migr'
license=('MIT')
depends=('glibc')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make migr migr-static
}

check() {
  cd "$pkgname-$pkgver"
  make test
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install install-static
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
